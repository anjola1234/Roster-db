# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (e.g. from Vercel Postgres/Neon, Supabase, or a
# local Postgres install). Use the SAME value in your Vercel project's
# environment variables so local dev and production share one database — or
# provision a second database for local dev if you'd rather keep them apart.
# Prefer the "pooled"/pgbouncer connection string if your provider offers one;
# serverless functions open a fresh connection per invocation.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random 32+ byte secret used to sign session tokens. Generate with e.g.
# `openssl rand -base64 32`. Never reuse the dev value below in production.
SESSION_SECRET="replace-with-a-long-random-secret-value"
