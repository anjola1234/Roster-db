# Copy this file to .env and fill in real values. Never commit .env.

# SQLite file path (relative to prisma/schema.prisma). For production, point
# this at a real database file location outside of source control.
DATABASE_URL="file:./dev.db"

# Random 32+ byte secret used to sign session tokens. Generate with e.g.
# `openssl rand -base64 32`. Never reuse the dev value below in production.
SESSION_SECRET="replace-with-a-long-random-secret-value"
