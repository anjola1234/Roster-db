// IndexOne data schema
// Real relational model backing the directory (replaces the old static JS mock data).
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// This file implements the "directory-database-D1-D5-signals.xlsx" target
// schema (D1 base/extension schemas, D5 region + category taxonomy, the
// Signals layer, Trust & Community, People & Products). Two naming calls were
// made to minimize blast radius on the existing app:
//   - the doc's `listings` table is modeled here as `Company` (unchanged name)
//   - the doc's `category_taxonomy` / `region_taxonomy` are `Industry` / `Region`
// Everything else follows the document's field-for-field shape.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// D5 · Category taxonomy (doc: category_taxonomy). Self-referencing tree:
// vertical (Fintech/Healthcare/Education/Legal) -> category/sub-category
// (Payments, Hospitals, ...). `schemaExtension` records which D1 extension
// schema applies (hospitals_schema / fintech_schema / base only / TBD).
// A Company always points at a leaf (category/sub-category) Industry row;
// the vertical is reached via `parent`.
// ---------------------------------------------------------------------------
model Industry {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  icon            String?
  accent          String?
  level           String // "vertical" | "category" | "sub-category"
  schemaExtension String? // "hospitals_schema" | "fintech_schema" | "base only" | "TBD" | null
  note            String?
  parentId        String?
  parent          Industry?  @relation("IndustryChildren", fields: [parentId], references: [id])
  children        Industry[] @relation("IndustryChildren")

  companies          Company[] // primary category
  secondaryCompanies CompanyCategory[] // listing_categories (extra categories)
  features           Feature[]
  fieldDefinitions   FieldDefinition[]

  @@index([parentId])
}

// Feature / specialty tag taxonomy (D5 "Features & Tags" — the second filter
// layer, separate from category), scoped to a top-level vertical.
model Feature {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  group      String
  industryId String
  industry   Industry  @relation(fields: [industryId], references: [id])
  companies  Company[] @relation("CompanyFeatures")

  @@index([industryId])
}

// D1 field_definitions — the registry that makes the schema "customizable":
// adding a category later = inserting field_definitions rows, not a rebuild.
model FieldDefinition {
  id           String   @id @default(cuid())
  industryId   String
  industry     Industry @relation(fields: [industryId], references: [id])
  fieldKey     String // snake_case machine name
  label        String
  dataType     String // text|number|currency|date|url|enum|multi-select|boolean|...
  required     Boolean  @default(false)
  optionsJson  Json?
  section      String?
  displayOrder Int?
  helpText     String?

  @@unique([industryId, fieldKey])
  @@index([industryId])
}

// ---------------------------------------------------------------------------
// D5 · Region taxonomy (doc: region_taxonomy). Self-referencing tree:
// country (Nigeria) -> state -> city (LGA level optional, supported by the
// same self-referencing shape without a schema change).
// ---------------------------------------------------------------------------
model Region {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  level    String // "country" | "state" | "lga" | "city"
  isoCode  String?
  note     String?
  parentId String?
  parent   Region?  @relation("RegionChildren", fields: [parentId], references: [id])
  children Region[] @relation("RegionChildren")

  companies   CompanyRegion[]
  jobPostings JobPosting[]

  @@index([parentId])
}

model CompanyRegion {
  id        String  @id @default(cuid())
  companyId String
  regionId  String
  isPrimary Boolean @default(false)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  region    Region  @relation(fields: [regionId], references: [id])

  @@unique([companyId, regionId])
  @@index([regionId])
}

// D1 listing_categories — secondary categories beyond the Company's primary
// `industryId`. Mechanism only; none of the 11 seeded companies use it yet.
model CompanyCategory {
  id         String   @id @default(cuid())
  companyId  String
  industryId String
  isPrimary  Boolean  @default(false)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id])

  @@unique([companyId, industryId])
  @@index([industryId])
}

model Investor {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  type        String
  website     String?
  investments CompanyInvestor[]
}

model CompanyInvestor {
  id             String        @id @default(cuid())
  companyId      String
  investorId     String
  fundingRoundId String?
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investor       Investor      @relation(fields: [investorId], references: [id])
  fundingRound   FundingRound? @relation(fields: [fundingRoundId], references: [id])

  @@unique([companyId, investorId, fundingRoundId])
  @@index([investorId])
}

model FundingRound {
  id           String            @id @default(cuid())
  companyId    String
  round        String // pre-seed|seed|Series A/B/C|debt|grant|Acquisition (free text, matches D1 round_type vocabulary)
  date         String
  amount       Float?
  currency     String? // USD|NGN|EUR|GBP
  leadInvestor String?
  sourceUrl    String?
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investors    CompanyInvestor[]

  @@index([companyId])
}

// D1/S "People & Products" — Person is now company-agnostic (a person can
// found multiple companies); the link + role/tenure lives on ListingPerson.
model Person {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  headline  String?
  photo     String?
  linkedin  String?
  createdAt DateTime @default(now())

  listings ListingPerson[]
}

model ListingPerson {
  id        String    @id @default(cuid())
  personId  String
  companyId String
  role      String // founder|co-founder|ceo|executive|board|former
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(true)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([personId, companyId, role])
  @@index([companyId])
  @@index([personId])
}

model Review {
  id            String   @id @default(cuid())
  companyId     String
  userId        String? // nullable: existing seed reviews are demo content with no real account behind them
  authorName    String
  authorRole    String
  rating        Int
  title         String
  body          String
  status        String   @default("pending") // pending|published|rejected|removed
  ownerResponse String?
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
}

model Company {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  logoInitials String
  logoColor    String
  industryId   String
  industry     Industry @relation(fields: [industryId], references: [id])
  shortDescription String
  longDescription  String
  website          String
  heroImageId      String?
  socials          Json?

  // Company registration — shared Base field (D1: CAC applies to every NG company)
  registrationBody   String? @default("CAC (Nigeria)")
  registrationNumber String?
  registrationLink   String?

  foundingYear  Int?
  employeeRange String?
  businessModel String?
  regulator     String?

  status         String    @default("active") // listing_status: draft|active|archived (also "pending" for submissions)
  verification   String    @default("unverified") // verification_status: verified | unverified | flagged
  source         String?
  lastVerifiedAt DateTime?
  submittedByEmail String?

  ratingScore Float?
  ratingCount Int    @default(0)
  ratingDist  Json?

  // The customizable payload for genuinely new/uncommon fields going forward.
  // High-value queryable fintech/hospital fields stay as real typed columns
  // below (per the doc's own "selectively promoted to real columns" allowance).
  customFields Json?

  // ---- fintech-specific (nullable for non-fintech rows) ----
  totalFunding  Float?
  valuation     Float?
  valuationDate String?
  licenses      Json?

  // ---- hospital-specific (nullable for non-hospital rows) ----
  hospitalType      String?
  ownership         String?
  yearEstablished   Int?
  bedCapacity       Int?
  emergency         Boolean?
  city              String?
  address           String?
  services          Json?
  accreditation     Json?
  accreditationBody String?
  facilityBody      String?
  facilityNo        String?
  contactPhone      String?
  contactEmail      String?

  createdAt DateTime @default(now())

  // ---- company activity (lifecycle status + computed activity score) ----
  // lifecycleStatus is an editorial fact set by a human ("operating" | "closed" |
  // "acquired" | "merged" | "unverified") — mirrors the plain-string convention
  // already used above for `status`/`verification` rather than a Prisma enum.
  // activityScore/activityLabel/activityScorePrev are denormalized reads of
  // this Company's latest `Score` row (scoreType="activity") for fast page
  // reads — the `Score` table (see below) is the real source of truth.
  lifecycleStatus      String    @default("unverified")
  activityScore        Int?
  activityLabel        String? // "growing" | "active" | "low_activity" | "at_risk" | "dormant"
  activityScorePrev    Int?
  websiteStatus        String? // "reachable" | "unreachable" | "parked" | "error"
  websiteLastCheckedAt DateTime?
  websiteLastChangedAt DateTime?
  websiteContentHash   String?
  socialStatus         String    @default("not_monitored")
  socialLastPostAt     DateTime?

  regions       CompanyRegion[]
  categories    CompanyCategory[]
  tags          Feature[]         @relation("CompanyFeatures")
  investors     CompanyInvestor[]
  fundingRounds FundingRound[]
  listingPeople ListingPerson[]
  reviews       Review[]

  websiteChecks WebsiteCheck[]
  scores        Score[]

  socialMetrics     SocialMetric[]
  newsItems         NewsItem[]
  jobPostings       JobPosting[]
  trafficEstimates  TrafficEstimate[]
  fieldProvenance   FieldProvenance[]

  verifications ListingVerification[]
  claims        ListingClaim[]
  corrections   ListingCorrection[]

  products Product[]
  awards   Award[]

  currentSignal ListingCurrentSignal?

  @@index([industryId])
}

// Append-only history of real website-reachability checks used to compute a
// Company's activityScore. See src/lib/activityCheck.ts for the heuristic.
// Matches D1 Signals `website_checks` table; `result` is an extra field (not
// in the source doc verbatim) kept to drive the existing parked-domain /
// reachability heuristic.
model WebsiteCheck {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  checkedAt       DateTime @default(now())
  url             String
  httpStatus      Int?
  isUp            Boolean
  responseMs      Int?
  sslValid        Boolean?
  sslExpiresOn    DateTime?
  domainExpiresOn DateTime?
  finalUrl        String?
  lighthousePerf  Int?
  errorNote       String?
  result          String // "reachable" | "unreachable" | "parked" | "error"
  /// Hash of the fetched page body at the time of this check. Company holds
  /// only the latest hash, which is enough to detect "changed since last
  /// time" but not to say anything about a trend. Storing it per check makes
  /// the website-content signal measurable over a window instead of a single
  /// step, and lets it honestly report "not measured" until two checks exist.
  contentHash     String?

  @@index([companyId, checkedAt])
}

// S · Scores & Provenance -----------------------------------------------------

model Score {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scoreType      String // activity|website_health|social_presence|funding_strength|overall
  value          Float
  band           String? // booming|growing|stable|quiet|dormant
  componentsJson Json // per-input contribution, e.g. {"website": 100}
  coverage       Float // 0-1, share of inputs with real data
  weightsVersion String
  computedAt     DateTime @default(now())

  @@index([companyId, scoreType, computedAt])
}

// Config, not code — never edit a published version, create the next one.
model ScoreWeight {
  version         String
  scoreType       String
  component       String
  weight          Float
  decayDays       Int?
  minObservations Int?
  effectiveFrom   DateTime

  @@id([version, scoreType, component])
}

model DataSource {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  kind          String // official_api|registry|rss|scrape|manual|partner
  trustRank     Int
  isPaid        Boolean   @default(false)
  termsUrl      String?
  rateLimitNote String?
  lastRunAt     DateTime?

  socialMetrics     SocialMetric[]
  jobPostings       JobPosting[]
  trafficEstimates  TrafficEstimate[]
  fieldProvenance   FieldProvenance[]
  crawlRuns         CrawlRun[]
}

model FieldProvenance {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fieldKey   String
  valueText  String
  sourceId   String
  source     DataSource @relation(fields: [sourceId], references: [id])
  sourceUrl  String?
  confidence Float?
  fetchedAt  DateTime
  isWinning  Boolean    @default(false)

  /// Spec section 14 requires evidence to record who checked it and when, and
  /// section 29 draws the line this enforces: holding a value (data) and
  /// citing a source (evidence) is NOT the same as a person confirming it
  /// (verification). An unverified row is a lead; a verified one is a fact
  /// somebody put their name to.
  verifiedById String?
  verifiedBy   User?     @relation("ProvenanceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  /// Admin's free-text note — what they checked, and any caveat.
  note         String?
  createdAt    DateTime  @default(now())

  @@index([companyId, fieldKey])
  @@index([sourceId])
  @@index([verifiedById])
}

model CrawlRun {
  id             String     @id @default(cuid())
  sourceId       String
  source         DataSource @relation(fields: [sourceId], references: [id])
  startedAt      DateTime
  finishedAt     DateTime?
  status         String // success|partial|failed|rate_limited
  recordsIn      Int?
  recordsWritten Int?
  errorNote      String?

  @@index([sourceId])
}

// S · Observations (append-only time series, never UPDATEd) ------------------

model SocialMetric {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform       String // linkedin|x|instagram|facebook|youtube|tiktok
  observedAt     DateTime
  handle         String?
  followers      Int?
  postsTotal     Int?
  posts30d       Int?
  engagementRate Float?
  lastPostAt     DateTime?
  sourceId       String?
  source         DataSource? @relation(fields: [sourceId], references: [id])
  isEstimate     Boolean     @default(false)

  @@index([companyId, observedAt])
}

model NewsItem {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  headline    String
  url         String    @unique
  outlet      String?
  summary     String?
  itemType    String? // funding|launch|expansion|hiring|award|leadership|legal|closure|other
  sentiment   String? // positive|neutral|negative
  relevance   Float?
  isHidden    Boolean   @default(false)

  @@index([companyId])
}

model JobPosting {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  postedAt    DateTime?
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime?
  location    String?
  regionId    String?
  region      Region?     @relation(fields: [regionId], references: [id])
  isRemote    Boolean     @default(false)
  department  String? // engineering|sales|ops|finance|other
  sourceId    String?
  source      DataSource? @relation(fields: [sourceId], references: [id])
  sourceUrl   String?

  @@index([companyId])
}

model TrafficEstimate {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth    DateTime // first-of-month
  visitsEstimate Int?
  rankCountry    Int?
  sourceId       String?
  source         DataSource? @relation(fields: [sourceId], references: [id])

  @@index([companyId, periodMonth])
}

// S · Trust & Community --------------------------------------------------------

model ListingVerification {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  badgeType    String // website|cac|founder|email|phone|claimed|licence
  status       String    @default("pending") // pending|verified|rejected|expired
  method       String? // dns_txt|email_link|document|registry_lookup|manual
  evidenceUrl  String?
  verifiedById String? // admin/user id, not FK-enforced
  verifiedAt   DateTime?
  expiresAt    DateTime?
  note         String?

  @@index([companyId])
}

model ListingClaim {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  claimedRole String // owner|employee|agency|other
  proofMethod String // work_email|dns_txt|document|phone_callback
  status      String    @default("pending") // pending|approved|rejected|revoked
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([userId])
}

model ListingCorrection {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  correctionType String // edit_field|report_closed|duplicate|wrong_category|abuse
  fieldKey       String?
  proposedValue  String?
  evidenceUrl    String?
  status         String    @default("pending") // pending|accepted|rejected|merged
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId])
}

// S · People & Products --------------------------------------------------------

model Product {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  productUrl  String?
  platform    Json? // multi-select: web|ios|android|ussd|api
  appStoreId  String?
  status      String? // live|beta|discontinued

  @@index([companyId])
}

model Award {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  awardedBy String?
  awardedOn DateTime?
  sourceUrl String?

  @@index([companyId])
}

// Read model, NOT source of truth — one row per listing holding the newest
// value of every signal so pages/filters never scan raw time-series. Rebuilt
// after each crawl; schema-only for now (no crawlers exist yet to populate it).
model ListingCurrentSignal {
  companyId        String    @id
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isWebsiteUp      Boolean?
  websiteCheckedAt DateTime?
  uptime30d        Float?
  followersTotal   Int?
  lastSocialPostAt DateTime?
  newsCount90d     Int?
  openJobs         Int?
  totalFunding     Float?
  overallScore     Float?
  scoreBand        String?
  refreshedAt      DateTime  @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // "user" | "admin". Plain string rather than a Prisma enum, matching the
  // convention already used for Company.status / Review.status above.
  // Granted out-of-band (`npm run make-admin -- email@example.com`), never
  // through signup — nothing in the public API can ever write this field.
  role         String    @default("user")
  auditLogs    AuditLog[]
  verifiedProvenance FieldProvenance[] @relation("ProvenanceVerifier")
  createdAt    DateTime  @default(now())
  sessions     Session[]
  reviews      Review[]
  claims       ListingClaim[]
  corrections  ListingCorrection[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// An append-only record of every consequential admin action.
///
/// Section 26 of the product spec makes this the integrity protection for the
/// whole directory: who changed what, from what, to what, why, and on what
/// evidence. It is the one thing that cannot be backfilled — a day without it
/// is a day of history permanently lost — which is why it comes before the
/// richer intelligence features.
///
/// Deliberately denormalised. `actorEmail`, `targetLabel` and the value diff
/// are snapshotted as text at write time rather than joined at read time, so
/// the log still reads correctly after the company is deleted or the admin's
/// account is removed. An audit trail that goes blank when the subject is
/// deleted is not an audit trail.
model AuditLog {
  id String @id @default(cuid())

  // --- who ---
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // snapshot; survives account deletion

  // --- what ---
  action     String // "company.approve", "review.publish", "claim.reject", ...
  entityType String // "Company" | "Review" | "ListingClaim" | ...
  entityId   String
  targetLabel String // snapshot of the human name, e.g. "Julius Berger Nigeria"

  /// Field-level diff: [{ field, from, to }]. Null for actions without one
  /// (a bulk import, a delete), where `summary` carries the meaning instead.
  changes Json?
  summary String?

  // --- why ---
  /// Free-text justification. The spec's example ("Website unavailable + no
  /// social activity for 14 months") is exactly this field.
  reason String?
  /// Supporting URLs or check references the admin relied on.
  evidence Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}
